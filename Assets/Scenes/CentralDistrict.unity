  arrestChoiceText: {fileID: 763571125}
  letGoChoiceText: {fileID: 2038133533}
  arrestChoiceLabel: Arrest him
  letGoChoiceLabel: Let him go
  suspectEnemy: {fileID: 1939402012}
  playerCombat: {fileID: 2400000001}
  playerControlsToLock:
