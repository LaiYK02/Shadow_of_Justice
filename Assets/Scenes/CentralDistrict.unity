  m_GameObject: {fileID: 1760118669}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ac383de05401f9d43a23c275e2afcf75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialoguePanel: {fileID: 2133330070}
  portraitImage: {fileID: 44095699}
  speakerNameText: {fileID: 1564501594}
  dialogueText: {fileID: 1051479745}
  continueButton: {fileID: 163925819}
  spacePromptText: {fileID: 0}
  openingDialogue:
  - speakerName: Sheriff
    dialogueText: 'Welcome to Seri Sentosa Police Department, Officer.

      I''m
      glad to have you on the team.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Sheriff
    dialogueText: 'This city needs officers who protect the public and respect the
      law.

      Remember, no one is above the law, regardless of their wealth,
      status, or influence.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Sheriff
    dialogueText: 'Today is your first day in the field.

      Start by learning
      our procedures, paying attention to details, and treating every citizen fairly.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Sheriff
    dialogueText: 'Your fellow officer is waiting outside.

      Speak to them,
      and they''ll brief you on your first assignment.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Sheriff
    dialogueText: 'Do your duty, Officer.

      Gather the facts, follow the evidence,
      and never let anyone influence your judgment.

      Good luck.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
