  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 260475049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89171f4252efde64db2eb81ef79b15e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OfficerInteraction
  interactionRange: 3
  targetCollider: {fileID: 1828018288}
  interactionPrompt: {fileID: 929840150}
  dialogueManager: {fileID: 1760118670}
  firstConversation:
  - speakerName: Fellow Officer
    dialogueText: Welcome to the district. Since this is your first day, I'll brief
      you on your first assignment.
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Fellow Officer
    dialogueText: Your task is to begin investigating a report and gather the facts
      before drawing conclusions. Follow the evidence and remember that the law applies
      to everyone.
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  - speakerName: Fellow Officer
    dialogueText: When you're ready, start by checking the nearby area. I'll be here
      if you need a reminder.
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
  repeatConversation:
  - speakerName: Fellow Officer
    dialogueText: 'To recap: investigate the report, check the nearby area, and gather
      evidence before making any conclusions. Follow the law and let the facts guide
      you.'
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
