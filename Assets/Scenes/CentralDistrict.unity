  escapeCameraHoldDuration: 2
  turnSpeed: 540
  arrivalDistance: 0.05
  suspectDialogue:
  - speakerName: Suspicious Person
    dialogueText: Oh no! He discovered the evidence of my crime!
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
    speaker: {fileID: 0}
  - speakerName: Suspicious Person
    dialogueText: I have to run... now!
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
    speaker: {fileID: 0}
  caughtSuspectDialogue:
  - speakerName: Suspicious Person
    dialogueText: Please, let me go. I can pay you well if you look the other way.
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
    speaker: {fileID: 0}
  - speakerName: Suspicious Person
    dialogueText: Take the money and forget you ever saw me.
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
    speaker: {fileID: 0}
  arrestDialogue:
  - speakerName: Suspicious Person
    dialogueText: Are you an idiot? Why wouldn't you take the benefits? I won't let
      you catch me. You shall die!
    portrait: {fileID: 21300000, guid: 33715be2192fc0448ac18e33f255bec8, type: 3}
    speaker: {fileID: 0}
