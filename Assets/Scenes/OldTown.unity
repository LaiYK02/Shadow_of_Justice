  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MiraInteraction
  interactionRange: 3
  targetCollider: {fileID: 1787772322}
  interactionPrompt: {fileID: 1983725580}
  dialogue: {fileID: 357977787}
  speaker: {fileID: 1343718335}
  hud: {fileID: 1141561843}
  marker: {fileID: 459884987}
  missionPanel: {fileID: 1198162754}
  missionTitle: {fileID: 177671980}
  objectiveLabel: {fileID: 1287654810}
  missionStartPanel: {fileID: 1864093730}
  fadeIn: 0.5
  hold: 2
  fadeOut: 0.5
  briefing:
  - speakerName: Mira
    dialogueText: "Officer? I\u2019m Mira. My delivery van disappeared from this
      spot yesterday."
    portrait: {fileID: 0}
    speaker: {fileID: 0}
  - speakerName: Mira
    dialogueText: Imran Salleh had booked it to take a sealed pouch to the police
      station. He worked in the harbour records office. He always called when a delivery
      was late.
    portrait: {fileID: 0}
    speaker: {fileID: 0}
  - speakerName: Mira
    dialogueText: "A mechanic saw my van at the workshop down the road. Please check
      what\u2019s still inside."
    portrait: {fileID: 0}
    speaker: {fileID: 0}
